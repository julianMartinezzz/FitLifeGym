<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fitlife.controller.MisReservasController"
            stylesheets="@../styles.css" styleClass="root"
            prefWidth="1000" prefHeight="700">

    <left>
        <VBox spacing="5" prefWidth="200" styleClass="sidebar">
            <padding><Insets top="30" left="10" right="10"/></padding>
            <Label text="FitLife Gym" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 0 0 20 10;"/>

            <Button text="Inicio" onAction="#volverMenu" styleClass="button-sidebar" maxWidth="Infinity"/>
            <Button text="Clases" onAction="#irAHorarios" styleClass="button-sidebar" maxWidth="Infinity"/>
            <Button text="Mis Reservas" styleClass="button-sidebar" style="-fx-text-fill: white; -fx-background-color: #222;" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="25" style="-fx-background-color: #050505;">
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>

            <HBox alignment="CENTER_LEFT">
                <VBox>
                    <Label text="Inicio / Mis Reservas" styleClass="label-breadcrumb"/>
                    <Label text="Mis Reservas" styleClass="label-section-title"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Cliente" style="-fx-text-fill: #888888; -fx-font-style: italic;"/>
            </HBox>

            <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-border-color: #333333; -fx-border-radius: 10; -fx-padding: 15;">
                <Label text="Próximas (Activas)" style="-fx-text-fill: #AAAAAA; -fx-font-weight: bold; -fx-font-style: italic;"/>

                <TableView fx:id="tablaActivas" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colClaseA" text="Clase" prefWidth="150"/>
                        <TableColumn fx:id="colFechaA" text="Fecha Reserva" prefWidth="100"/>
                        <TableColumn fx:id="colHoraA" text="Hora Clase" prefWidth="100"/>
                        <TableColumn fx:id="colSalaA" text="Sala" prefWidth="100"/>
                        <TableColumn fx:id="colAccionA" text="Acción" prefWidth="120"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
            </VBox>

            <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-border-color: #333333; -fx-border-radius: 10; -fx-padding: 15;">
                <Label text="Historial" style="-fx-text-fill: #AAAAAA; -fx-font-weight: bold; -fx-font-style: italic;"/>

                <TableView fx:id="tablaHistorial" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colClaseH" text="Clase" prefWidth="150"/>
                        <TableColumn fx:id="colFechaH" text="Fecha" prefWidth="100"/>
                        <TableColumn fx:id="colHoraH" text="Hora" prefWidth="100"/>
                        <TableColumn fx:id="colEstadoH" text="Estado" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
            </VBox>

        </VBox>
    </center>
</BorderPane>