<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fitlife.controller.MisPagosController"
            stylesheets="@../styles.css" styleClass="root"
            prefWidth="1000" prefHeight="700">

    <left>
        <VBox spacing="5" prefWidth="200" styleClass="sidebar">
            <padding><Insets top="30" left="10" right="10"/></padding>
            <Label text="FitLife Gym" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 0 0 20 10;"/>

            <Button text="Inicio" onAction="#volverMenu" styleClass="button-sidebar" maxWidth="Infinity"/>
            <Button text="Clases" onAction="#irAClases" styleClass="button-sidebar" maxWidth="Infinity"/>
            <Button text="Mis Reservas" onAction="#irAMisReservas" styleClass="button-sidebar" maxWidth="Infinity"/>
            <Button text="Pagos" styleClass="button-sidebar" style="-fx-text-fill: white; -fx-background-color: #222;" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="25" style="-fx-background-color: #050505;">
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>

            <HBox alignment="CENTER_LEFT">
                <VBox>
                    <Label text="Inicio / Pagos" styleClass="label-breadcrumb"/>
                    <Label text="Mi Membresía y Pagos" styleClass="label-section-title"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Cliente" style="-fx-text-fill: #888888; -fx-font-style: italic;"/>
            </HBox>

            <HBox styleClass="panel-oscuro" spacing="30" alignment="CENTER_LEFT" style="-fx-background-color: #111;">
                <VBox spacing="5">
                    <Label text="ESTADO DEL PLAN" style="-fx-text-fill: #888; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblEstadoPlan" text="Activo" style="-fx-text-fill: #27ae60; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                </VBox>
                <Region prefWidth="20"/>
                <VBox spacing="5">
                    <Label text="FECHA DE VENCIMIENTO" style="-fx-text-fill: #888; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                    <Label fx:id="lblVencimiento" text="Cargando..." style="-fx-text-fill: white; -fx-font-size: 18px;"/>
                </VBox>
            </HBox>

            <VBox spacing="10" styleClass="panel-oscuro">
                <Label text="Renovar Membresía" styleClass="label-panel-title"/>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label text="Seleccione Plan:" style="-fx-text-fill: #DDD;"/>
                    <ComboBox fx:id="comboPlanes" promptText="Mensualidad ($80.000)" styleClass="combo-box" prefWidth="250"/>

                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Pagar Ahora" onAction="#realizarPago" styleClass="button-pill" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                </HBox>
            </VBox>

            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <Label text="Historial de Transacciones" styleClass="label-panel-title"/>
                <TableView fx:id="tablaPagos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="150"/>
                        <TableColumn fx:id="colConcepto" text="Concepto" prefWidth="300"/>
                        <TableColumn fx:id="colMonto" text="Monto" prefWidth="150"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
            </VBox>

        </VBox>
    </center>
</BorderPane>