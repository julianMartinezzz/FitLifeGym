<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fitlife.controller.InstructorClasesController"
            stylesheets="@../styles.css" styleClass="root"
            prefWidth="1000" prefHeight="700">

    <left>
        <VBox spacing="5" prefWidth="200" styleClass="sidebar">
            <padding><Insets top="30" left="10" right="10"/></padding>
            <Label text="FitLife Gym" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 0 0 20 10;"/>

            <Button text="Inicio" onAction="#volverMenu" styleClass="button-sidebar" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" style="-fx-background-color: #050505;">
            <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

            <HBox alignment="CENTER_LEFT">
                <VBox>
                    <Label text="Instructor / Mis Clases" styleClass="label-breadcrumb"/>
                    <Label text="Gestión de Asistencia" styleClass="label-section-title"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Entrenador" style="-fx-text-fill: #888888; -fx-font-style: italic;"/>
            </HBox>

            <SplitPane dividerPositions="0.4" style="-fx-background-color: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS">

                <VBox spacing="10" styleClass="panel-oscuro">
                    <Label text="1. Seleccione una Clase" styleClass="label-panel-title"/>
                    <TableView fx:id="tablaClases" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colClase" text="Actividad" prefWidth="120"/>
                            <TableColumn fx:id="colDia" text="Día" prefWidth="90"/>
                            <TableColumn fx:id="colHora" text="Hora" prefWidth="70"/>
                            <TableColumn fx:id="colReservas" text="Inscritos" prefWidth="70"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    </TableView>
                </VBox>

                <VBox spacing="10" styleClass="panel-oscuro">
                    <Label fx:id="lblClaseSeleccionada" text="2. Lista de Alumnos" styleClass="label-panel-title" style="-fx-text-fill: #27ae60;"/>

                    <TableView fx:id="tablaAsistentes" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colAlumno" text="Nombre Alumno" prefWidth="150"/>
                            <TableColumn fx:id="colDocumento" text="Documento" prefWidth="100"/>
                            <TableColumn fx:id="colAsistencia" text="¿Asistió?" prefWidth="80" style="-fx-alignment: CENTER;"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    </TableView>

                    <Label text="* Verifique la identidad del alumno con su documento." style="-fx-text-fill: #666; -fx-font-size: 11px;"/>
                </VBox>

            </SplitPane>
        </VBox>
    </center>
</BorderPane>