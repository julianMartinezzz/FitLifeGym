<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fitlife.controller.ReporteController"
            stylesheets="@../styles.css" styleClass="root"
            prefWidth="900" prefHeight="600">

    <left>
        <VBox spacing="5" prefWidth="200" styleClass="sidebar">
            <padding>
                <Insets top="30" left="10" right="10"/>
            </padding>

            <Label text="FitLife Gym" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 0 0 20 10;"/>

            <Button text="Inicio" onAction="#volverMenu" styleClass="button-sidebar" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="20" style="-fx-background-color: #050505;">
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>

            <HBox alignment="CENTER_LEFT">
                <VBox>
                    <Label text="Administración / Gestión de Clientes" styleClass="label-breadcrumb"/>
                    <Label text="Gestión de Clientes" styleClass="label-section-title"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/> <Label text="Administrador" style="-fx-text-fill: #888888; -fx-font-style: italic;"/>
            </HBox>



            <VBox spacing="10" VBox.vgrow="ALWAYS">
                <Label text="Tabla de Clientes" style="-fx-text-fill: #888888; -fx-font-weight: bold;"/>

                <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="50.0" />
                        <TableColumn fx:id="colDocumento" text="Documento" prefWidth="120.0" />
                        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200.0" />
                        <TableColumn fx:id="colPlan" text="Membresía" prefWidth="150.0" />
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="100.0" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>

            <HBox spacing="15">
                <Button text="Actualizar Datos" onAction="#cargarDatos" styleClass="button-pill"/>
                <Button text="Exportar a PDF" onAction="#exportarPDF" styleClass="button-pill" style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                <Button text="Cambiar Estado" onAction="#toggleEstado" styleClass="button-pill" style="-fx-background-color: #333333; -fx-text-fill: white;"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>