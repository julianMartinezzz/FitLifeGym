<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="350.0" prefWidth="500.0" spacing="20.0"
      style="-fx-background-color: #050505; -fx-border-color: #333; -fx-border-width: 1;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fitlife.controller.SplashController">

    <ImageView fitHeight="120.0" fitWidth="120.0" pickOnBounds="true" preserveRatio="true">
        <image>
            <Image url="@../images/logo_fitlife.png" />
        </image>
    </ImageView>

    <Label text="FITLIFE GYM" textFill="WHITE">
        <font>
            <Font name="Impact" size="36.0" />
        </font>
    </Label>

    <Label text="Sistema de Gestión Integral" textFill="#888888">
        <font>
            <Font size="14.0" />
        </font>
    </Label>

    <VBox alignment="CENTER" spacing="8">
        <ProgressBar fx:id="barraProgreso" prefWidth="350.0" progress="0.0"
                     style="-fx-accent: #27ae60;
                            -fx-control-inner-background: #1a1a1a;
                            -fx-text-box-border: transparent;
                            -fx-background-radius: 10;
                            -fx-padding: 1;" />

        <Label fx:id="lblEstado" text="Iniciando..." textFill="#666666">
            <font>
                <Font name="Segoe UI Italic" size="11.0" />
            </font>
        </Label>
    </VBox>

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>