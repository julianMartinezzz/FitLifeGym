<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fitlife.controller.ReservaController"
            stylesheets="@../styles.css" styleClass="root"
            prefWidth="1000" prefHeight="750">

    <left>
        <VBox spacing="5" prefWidth="200" styleClass="sidebar">
            <padding><Insets top="30" left="10" right="10"/></padding>

            <Label text="FitLife Gym" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 0 0 20 10;"/>

            <Button text="Inicio" onAction="#volverMenu" styleClass="button-sidebar" maxWidth="Infinity"/>
            <Button text="Clases" onAction="#irAClases" styleClass="button-sidebar" maxWidth="Infinity"/>
            <Button text="Reservas" styleClass="button-sidebar" style="-fx-text-fill: white; -fx-background-color: #222;" maxWidth="Infinity"/>
            <Button text="Pagos" onAction="#irAPagos" styleClass="button-sidebar" maxWidth="Infinity"/>
            <Button text="Perfil" onAction="#irAPerfil" styleClass="button-sidebar" maxWidth="Infinity"/>        </VBox>
    </left>

    <center>
        <VBox spacing="20" style="-fx-background-color: #050505;">
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>

            <HBox alignment="CENTER_LEFT">
                <VBox>
                    <Label text="Administración / Clases y Reservas" styleClass="label-breadcrumb"/>
                    <Label text="Clases y Reservas" styleClass="label-section-title"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Administrador" style="-fx-text-fill: #888888; -fx-font-style: italic;"/>
            </HBox>



            <VBox styleClass="panel-oscuro" spacing="10" VBox.vgrow="ALWAYS">
                <Label text="Tabla de clases" styleClass="label-panel-title"/>

                <TableView fx:id="tablaClases" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colClase" text="Clase" prefWidth="150"/>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                        <TableColumn fx:id="colHora" text="Hora" prefWidth="100"/>
                        <TableColumn fx:id="colSala" text="Sala" prefWidth="100"/>
                        <TableColumn fx:id="colCupos" text="Cupos" prefWidth="80"/>
                        <TableColumn fx:id="colAccion" text="Acción" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
            </VBox>

        </VBox>
    </center>
</BorderPane>