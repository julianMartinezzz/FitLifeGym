<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fitlife.controller.AdminPagosController"
            stylesheets="@../styles.css" styleClass="root"
            prefWidth="1000" prefHeight="700">

    <left>
        <VBox spacing="5" prefWidth="200" styleClass="sidebar">
            <padding><Insets top="30" left="10" right="10"/></padding>
            <Label text="FitLife Gym" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 0 0 20 10;"/>

            <Button text="Inicio" onAction="#volverMenu" styleClass="button-sidebar" maxWidth="Infinity"/>
            <Button text="Clases" onAction="#irAClases" styleClass="button-sidebar" maxWidth="Infinity"/>
            <Button text="Reservas" onAction="#irAReservas" styleClass="button-sidebar" maxWidth="Infinity"/>
            <Button text="Pagos" styleClass="button-sidebar" style="-fx-text-fill: white; -fx-background-color: #222;" maxWidth="Infinity"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="25" style="-fx-background-color: #050505;">
            <padding>
                <Insets top="30" right="40" bottom="30" left="40"/>
            </padding>

            <HBox alignment="CENTER_LEFT">
                <VBox>
                    <Label text="Administración / Pagos" styleClass="label-breadcrumb"/>
                    <Label text="Pagos" styleClass="label-section-title"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Administrador" style="-fx-text-fill: #888888; -fx-font-style: italic; -fx-padding: 0 20 0 0;"/>

                <Button text="Imprimir Comprobante" onAction="#imprimirComprobante" styleClass="button-pill" style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                <Region prefWidth="10"/>
                <Button text="Nuevo pago" onAction="#irANuevoPago" styleClass="button-pill"/>
            </HBox>

            <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-border-color: #333333; -fx-border-radius: 10; -fx-padding: 1; -fx-background-radius: 10;">
                <TableView fx:id="tablaPagos" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colFecha" text="Fecha" prefWidth="120"/>
                        <TableColumn fx:id="colCliente" text="Cliente" prefWidth="200"/>
                        <TableColumn fx:id="colMonto" text="Monto" prefWidth="100"/>
                        <TableColumn fx:id="colMetodo" text="Método" prefWidth="120"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                    </columns>
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>